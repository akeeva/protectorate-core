#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/../lib/bootstrap.sh"

clear

banner_main

ui_section "Project"
ui_item "Name"         "$PROJECT_NAME"
ui_item "Organization" "$ORGANIZATION"
ui_item "Division"     "$DIVISION"
ui_item "Project Version" "$PROJECT_VERSION"
printf "\n"

system_summary

if declare -F health_summary >/dev/null; then
    printf "\n"
    health_summary
fi

printf "\n"
